# ==============================================================================
# VAJRA (SIH 26183) — Shared Environment Variables
# Copy this file to .env: cp .env.example .env (NEVER commit .env)
# ==============================================================================

# Database — PostgreSQL (T5)
DATABASE_URL=postgresql://vajra_user:vajra_password@localhost:5432/vajra_db
POSTGRES_USER=vajra_user
POSTGRES_PASSWORD=vajra_password
POSTGRES_DB=vajra_db

# Graph Database — Neo4j Community (T5 / T1 / T2 / T3)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vajra_neo4j_password
NEO4J_DATABASE=sih2026
NEO4J_INSTANCE=

# Cache & Queue — Redis (T5 / T6)
REDIS_URL=redis://localhost:6379/0

# Object Storage — MinIO / S3-compatible (T5 / T6)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=vajra_minio_admin
MINIO_ROOT_PASSWORD=vajra_minio_secret_password
MINIO_ACCESS_KEY=vajra_minio_admin
MINIO_SECRET_KEY=vajra_minio_secret_password
MINIO_BUCKET=vajra-evidence

# AI / ML Service (T3 / T6)
MODEL_ARTIFACT_PATH=ml/artifacts
ML_DEVICE=cpu
# ML_DEVICE=cuda # Enable on NVIDIA GPU machines

# Security / Auth — JWT & RBAC (T6)
JWT_SECRET=vajra_jwt_super_secret_signing_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Blockchain Explorer APIs (T2)
EXPLORER_API_KEY_BTC=
EXPLORER_API_KEY_ETH=

# Frontend UX (T4)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=false

# External Simulation - T1
NCRP_MOCK_MODE=true
